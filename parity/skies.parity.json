{
  "$schema": "./skies.parity.schema.json",
  "schemaVersion": 1,
  "policy": {
    "behaviorPatterns": {
      "dotnet": [
        "analyzers/Skies.Framework.Doctor/**/*.cs",
        "examples/sample-app/backend/**/*.cs",
        "src/**/*.cs",
        "tests/Skies.Framework.*.Tests/**/*.cs",
        "analyzers/Skies.Framework.Doctor/*.csproj",
        "examples/sample-app/backend/**/*.csproj",
        "src/**/*.csproj",
        "src/Skies.Framework.Cli/Templates/**/*.cstmpl"
      ],
      "node": [
        "node-sdk/examples/pilot-api/src/**/*.ts",
        "node-sdk/examples/sample-api/src/**/*.ts",
        "node-sdk/packages/**/*.js",
        "node-sdk/packages/**/*.mjs",
        "node-sdk/packages/**/*.ts",
        "node-sdk/examples/pilot-api/package.json",
        "node-sdk/examples/pilot-api/skies.node.json",
        "node-sdk/examples/pilot-api/stryker.config.mjs",
        "node-sdk/examples/sample-api/package.json",
        "node-sdk/packages/*/package.json"
      ]
    },
    "ignoredBehavior": [
      "tests/Skies.Framework.SelfHarness.Tests/**/*.cs"
    ]
  },
  "sharedContracts": [
    {
      "id": "jwt.hs256",
      "path": "tests/fixtures/jwt-interop.json",
      "consumers": {
        "dotnet": [
          "tests/Skies.Framework.Auth.Tests/AccessTokenValidationTests.cs",
          "tests/Skies.Framework.Auth.Tests/Skies.Framework.Auth.Tests.csproj"
        ],
        "node": [
          "node-sdk/packages/auth/src/index.test.ts"
        ]
      }
    }
  ],
