{
  "color": {
    "$type": "color",
    "bg": { "$value": "#f8fafc" },
    "surface": { "$value": "#ffffff" },
    "border": { "$value": "#e2e8f0" },
    "borderStrong": { "$value": "#cbd5e1" },
    "text": { "$value": "#0f172a" },
    "textMuted": { "$value": "#64748b" },
    "primary": { "$value": "#2563eb" },
    "primaryHover": { "$value": "#1d4ed8" },
    "primaryActive": { "$value": "#1e40af" },
    "onPrimary": { "$value": "#ffffff" },
    "danger": { "$value": "#dc2626" },
    "dangerHover": { "$value": "#b91c1c" },
    "onDanger": { "$value": "#ffffff" },
    "focusRing": { "$value": "#2563eb" }
  },
  "space": {
    "$type": "dimension",
    "none": { "$value": { "value": 0, "unit": "px" } },
    "xs": { "$value": { "value": 4, "unit": "px" } },
    "sm": { "$value": { "value": 8, "unit": "px" } },
    "md": { "$value": { "value": 12, "unit": "px" } },
    "lg": { "$value": { "value": 16, "unit": "px" } },
    "xl": { "$value": { "value": 24, "unit": "px" } },
    "2xl": { "$value": { "value": 32, "unit": "px" } }
  },
  "radius": {
    "$type": "dimension",
    "none": { "$value": { "value": 0, "unit": "px" } },
    "sm": { "$value": { "value": 4, "unit": "px" } },
    "md": { "$value": { "value": 8, "unit": "px" } },
    "lg": { "$value": { "value": 12, "unit": "px" } },
    "full": { "$value": { "value": 9999, "unit": "px" } }
  },
  "motion": {
    "$type": "duration",
    "instant": { "$value": { "value": 0, "unit": "ms" } },
    "fast": { "$value": { "value": 100, "unit": "ms" } },
    "base": { "$value": { "value": 200, "unit": "ms" } },
    "slow": { "$value": { "value": 300, "unit": "ms" } }
  }
}
