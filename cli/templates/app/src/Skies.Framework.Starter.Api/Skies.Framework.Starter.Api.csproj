<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Skies.Framework.Abstractions" Version="4.1.4" />
    <PackageReference Include="Skies.Framework.AspNetCore" Version="4.1.4" />
    <!-- The doctor rides along as a build analyzer. Remove it and the app still compiles and runs
         (Law 2) — you only lose the enforcement. -->
    <PackageReference Include="Skies.Framework.Doctor" Version="4.1.4" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- A unit test may live next to the code it tests; the tests project compiles it, the app never
         does (no test deps ship). -->
    <Compile Remove="**\*.Tests.cs" />
    <!-- The doctor reads the module ctx docs (SKY0004/SKY0005) as AdditionalFiles. -->
    <AdditionalFiles Include="**\*.ctx.md" />
  </ItemGroup>

</Project>
