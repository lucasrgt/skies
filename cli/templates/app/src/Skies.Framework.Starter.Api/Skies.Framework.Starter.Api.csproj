<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Skies.Framework.Abstractions" Version="5.0.0-rc.1" />
    <PackageReference Include="Skies.Framework.AspNetCore" Version="5.0.0-rc.1" />
    <!-- The doctor rides along as a build analyzer. Remove it and the app still compiles and runs
         (Law 2) — you only lose the enforcement. -->
    <PackageReference Include="Skies.Framework.Doctor" Version="5.0.0-rc.1" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- The doctor reads the module ctx docs and the specs they cite as AdditionalFiles, to check that each
         ctx is written and that its citations still resolve. -->
    <AdditionalFiles Include="**\*.ctx.md" />
    <AdditionalFiles Include="..\..\.specs\*\spec.md" />
  </ItemGroup>

</Project>
