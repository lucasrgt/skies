using System.Net.Http.Headers;
using System.Net.Http.Json;
using MyApp.Api;
using MyApp.Api.Modules.Account;

namespace Specs.S__SPEC_ID__;

/// <summary>The Account endpoints as a client sees them. No X-Client header, so the refresh token rides in the
/// JSON body (mobile delivery) where the cases can read it.</summary>
internal static class AuthApi
{
    public const string Password = "password1";

    public sealed record Tokens(string AccessToken, string RefreshToken);

    public static async Task Register(HttpClient client, string email, string password = Password) =>
        (await client.PostAsJsonAsync("/account/register", new { email, password })).EnsureSuccessStatusCode();

    public static async Task<Tokens> Login(HttpClient client, string email, string password = Password)
    {
        var response = await client.PostAsJsonAsync("/account/login", new { email, password });
        response.EnsureSuccessStatusCode();
        return (await response.Content.ReadFromJsonAsync<Tokens>(AppJson.Options))!;
    }

    public static async Task<Tokens> SignUp(HttpClient client, string email)
    {
        await Register(client, email);
        return await Login(client, email);
    }

    public static Task<HttpResponseMessage> RefreshWith(HttpClient client, string refreshToken) =>
        client.PostAsJsonAsync("/account/refresh", new { refreshToken });

    /// <summary>A request authenticated with <paramref name="accessToken"/> as a Bearer header.</summary>
    public static HttpRequestMessage As(string accessToken, HttpMethod method, string path, object? body = null)
    {
        var request = new HttpRequestMessage(method, path);
        if (body is not null)
            request.Content = JsonContent.Create(body);
        request.Headers.Authorization = new AuthenticationHeaderValue("Bearer", accessToken);
        return request;
    }

    public static async Task<Me.Output> Profile(HttpClient client, string accessToken)
    {
        var response = await client.SendAsync(As(accessToken, HttpMethod.Get, "/account/me"));
        response.EnsureSuccessStatusCode();
        return (await response.Content.ReadFromJsonAsync<Me.Output>(AppJson.Options))!;
    }

    public static async Task<IReadOnlyList<ListMySessions.SessionEntry>> ListSessions(HttpClient client, string accessToken)
    {
        var response = await client.SendAsync(As(accessToken, HttpMethod.Get, "/account/sessions"));
        response.EnsureSuccessStatusCode();
        return (await response.Content.ReadFromJsonAsync<ListMySessions.Output>(AppJson.Options))!.Sessions;
    }
}
