/// <summary>Create __A_ENTITY____WITHIN__.
/// The slice never writes a column: the entity is born through <see cref="__ENTITY__.Open"/>, whose invariants
/// decide whether it may exist.__STAMPED__</summary>
[Slice]
public static class Create__ENTITY__
{
    public record Input(__INPUT_FIELDS__);

    public record Output(Guid Id, Guid Version);

