# Copy to .env.local (ignored) and point the web app at the API. Unset, the client calls http://localhost:8080,
# the port the backend's launchSettings.json pins. The API allows this dev server's origin in Development; a deployed
# web app's origin goes in the API's Cors:Origins (e.g. Cors__Origins__0=https://app.example.com).
VITE_API_URL=http://localhost:8080
