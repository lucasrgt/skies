import { fileURLToPath } from "node:url";
import { defineConfig, mergeConfig, type Plugin } from "vitest/config";
import viteConfig from "./vite.config";

const packageDir = fileURLToPath(new URL("./", import.meta.url));

// Every test lives in a spec at the application root (.specs/<id>-<slug>/e2e/), outside this package, where Node
// would not find this package's node_modules. A case's bare imports (react, @testing-library/react) resolve from here.
const resolveSpecImportsFromPackage: Plugin = {
  name: "resolve-spec-imports-from-package",
  enforce: "pre",
  resolveId(source, importer, options) {
    const fromSpec = importer?.replace(/\\/g, "/").includes("/.specs/") ?? false;
    if (!fromSpec || /^[./\0]/.test(source) || source.startsWith("@/")) return null;
    return this.resolve(source, `${packageDir}index.html`, { ...options, skipSelf: true });
  },
};

export default mergeConfig(
  viteConfig,
  defineConfig({
    plugins: [resolveSpecImportsFromPackage],
    // Vite caches under its root's node_modules by default, and the root here is the application's.
    cacheDir: fileURLToPath(new URL("./node_modules/.vite", import.meta.url)),
    test: {
      root: fileURLToPath(new URL("{{ app_root }}", import.meta.url)),
      include: [".specs/*/e2e/**/*.test.{ts,tsx}"],
      environment: "jsdom",
      passWithNoTests: true,
    },
  }),
);
