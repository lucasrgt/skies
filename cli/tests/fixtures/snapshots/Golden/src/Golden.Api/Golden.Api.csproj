<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- `dotnet build` writes the OpenAPI contract here (the GetDocument tool, no running server). Commit it: the
         typed clients (`skies g client`) and the feature scaffolds generate from it, and its diff shows a contract
         change in review. -->
    <OpenApiDocumentsDirectory>$(MSBuildProjectDirectory)/contract</OpenApiDocumentsDirectory>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Skies.Framework.Abstractions" Version="5.0.0-rc.3" />
    <PackageReference Include="Skies.Framework.AspNetCore" Version="5.0.0-rc.3" />
    <PackageReference Include="Microsoft.Extensions.ApiDescription.Server" Version="10.0.0" PrivateAssets="all" />
    <!-- The doctor rides along as a build analyzer. Remove it and the app still compiles and runs
         (Law 2) — you only lose the enforcement. -->
    <PackageReference Include="Skies.Framework.Doctor" Version="5.0.0-rc.3" PrivateAssets="all" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.8" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.8" />
    <PackageReference Include="Skies.Framework.Auth" Version="5.0.0-rc.3" />
    <PackageReference Include="Skies.Framework.EntityFrameworkCore" Version="5.0.0-rc.3" />
    <PackageReference Include="Skies.Framework.Sms" Version="5.0.0-rc.3" />
    <PackageReference Include="Skies.Framework.Identity" Version="5.0.0-rc.3" />
    <PackageReference Include="Skies.Framework.Mail" Version="5.0.0-rc.3" />
  </ItemGroup>

  <ItemGroup>
    <!-- The doctor reads the module ctx docs and the specs they cite as AdditionalFiles, to check that each
         ctx is written and that its citations still resolve. -->
    <AdditionalFiles Include="**\*.ctx.md" />
    <AdditionalFiles Include="..\..\.specs\*\spec.md" />
  </ItemGroup>

</Project>
