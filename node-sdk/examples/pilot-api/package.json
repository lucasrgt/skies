{
  "name": "@skiesjs/pilot-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Explicit-composition Skies wallet API pilot for Express 5 and PostgreSQL.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src tools *.config.*",
    "test": "vitest run --config vitest.config.ts",
    "doctor": "skies-node-doctor .",
    "check": "npm run lint && npm run typecheck && npm run doctor && npm run test && npm run build",
    "start": "node dist/server.js",
    "proofs": "skies-node-foundation inventory",
    "criteria": "skies-node-foundation criteria check",
    "gate:affected": "skies-node-foundation gate --affected",
    "gate:base": "skies-node-foundation gate --base origin/main --fast",
    "gate:full": "skies-node-foundation gate --full",
    "mutate": "stryker run stryker.config.mjs && node tools/assert-mutation.mjs",
    "gate:staged": "skies-node-foundation gate --staged"
  },
  "dependencies": {
    "@skiesjs/auth": "0.1.0",
    "@skiesjs/auth-express": "0.1.0",
    "@skiesjs/core": "0.1.0",
    "@skiesjs/drizzle-postgres": "0.1.0",
    "@skiesjs/express": "0.1.0",
    "@skiesjs/openapi": "0.1.0",
    "@skiesjs/storage": "0.1.0",
    "@skiesjs/storage-express": "0.1.0",
    "drizzle-orm": "0.45.2",
    "express": "5.2.1",
    "postgres": "3.4.9",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@skiesjs/doctor": "0.1.1",
    "@skiesjs/testing": "0.1.0",
    "@types/express": "5.0.6",
    "@types/node": "24.13.3",
    "@types/supertest": "6.0.3",
    "@typescript-eslint/parser": "8.66.0",
    "eslint": "9.39.5",
    "supertest": "7.2.2",
    "typescript": "5.9.3",
    "vitest": "4.1.10",
    "@skiesjs/foundation": "0.1.2",
    "@stryker-mutator/core": "9.6.0",
    "@stryker-mutator/typescript-checker": "9.6.0",
    "@stryker-mutator/vitest-runner": "9.6.0",
    "@skiesjs/eslint-plugin-node": "0.1.1"
  }
}
