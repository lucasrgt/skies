{
  "name": "@skiesjs/cli",
  "version": "0.1.4",
  "description": "The explicit scaffolding CLI for Skies Node.js applications.",
  "type": "module",
  "license": "MIT",
  "author": "Lucas Tinoco",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lucasrgt/skies.git",
    "directory": "node-sdk/packages/cli"
  },
  "engines": {
    "node": ">=24"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "skies-node": "./bin/skies-node.mjs"
  },
  "files": [
    "bin",
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run --root ../.. packages/cli",
    "lint": "eslint src"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@skiesjs/foundation": "0.1.3"
  }
}
