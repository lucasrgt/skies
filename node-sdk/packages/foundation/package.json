{
  "name": "@skiesjs/foundation",
  "version": "0.1.2",
  "description": "Fail-closed proof gates and local CSM foundations for Skies Node.js applications.",
  "type": "module",
  "license": "MIT",
  "author": "Lucas Tinoco",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lucasrgt/skies.git",
    "directory": "node-sdk/packages/foundation"
  },
  "engines": { "node": ">=24" },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" }
  },
  "bin": { "skies-node-foundation": "./bin/skies-node-foundation.mjs" },
  "files": ["bin", "dist", "README.md"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && vitest run --root ../.. packages/foundation/src",
    "lint": "eslint src bin"
  },
  "devDependencies": { "vitest": "^4.0.0" },
  "publishConfig": { "access": "public" },
  "sideEffects": false
}
