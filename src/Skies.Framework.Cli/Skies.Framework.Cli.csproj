<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <PackAsTool>true</PackAsTool>
    <ToolCommandName>skies</ToolCommandName>
    <!-- Published as `skies-framework-cli` (a descriptive package id distinct from the
         meta-package `Skies.Framework`). Install: `dotnet tool install -g skies-framework-cli`;
         the command is `skies`. -->
    <PackageId>skies-framework-cli</PackageId>

    <!-- Package metadata (the CLI doesn't import Skies.Framework.Library.props — that turns CS1591 into an error, and a
         tool isn't a documented library surface). 1.0 removes proof modes and topology fallbacks: one manifest,
         one complete fail-closed obligation with Git-derived incremental execution. -->
    <Version>4.1.16</Version>
    <Authors>Lucas Tinoco</Authors>
    <Description>The Skies CLI — scaffolds the convention bundle: new feature slices, entities, CRUD, and the auth flows. Install with `dotnet tool install -g skies-framework-cli`; run as `skies`. The companion to the Skies framework packages.</Description>
    <PackageTags>skies;cli;dotnet-tool;scaffolding;conventions;vertical-slice</PackageTags>
    <PackageProjectUrl>https://github.com/lucasrgt/skies</PackageProjectUrl>
    <RepositoryUrl>https://github.com/lucasrgt/skies</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Copyright>Copyright (c) Lucas Tinoco</Copyright>
    <NoDefaultExcludes>true</NoDefaultExcludes>
  </PropertyGroup>

  <!-- The auth blueprint templates. .cstmpl so they never compile into the CLI. Copied next to the tool
       (CopyToOutputDirectory) and read from disk at runtime — embedding them as resources hit an SDK quirk
       that collapsed the wildcard to a single manifest entry, so disk content is the reliable carrier for a
       CLI tool. The whole build output is packed verbatim under tools/<tfm>/any/, so this lands the templates
       beside the dll there with no extra Pack/PackagePath. A custom PackagePath also dropped a second copy at a
       non-standard tools/ path, which makes some SDKs fail to find DotnetToolSettings.xml on install. -->
  <ItemGroup>
    <None Include="Tools\*.mjs" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Templates\**\*.cstmpl" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\templates\skies-app\**\*"
          Exclude="..\..\templates\skies-app\node_modules\**\*"
          Link="ProjectTemplate\%(RecursiveDir)%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\README.md" Pack="true" PackagePath="\" Link="README.md" />
  </ItemGroup>

  <!-- The one allowed cross-repo dependency direction: framework → avp (Assay.Net is standalone, xUnit-like,
       and never knows the framework). It brings the neutral catalog (Catalog.LoadDefault) and the spec-manifest
       reader the gate and the criteria commands share with the runtime verifier. -->
  <ItemGroup>
    <PackageReference Include="Assay.Net" Version="0.4.0" />
    <!-- The verification matrix must distinguish real attributes from fixture/template strings. Roslyn syntax
         keeps this collector honest without compiling or semantically binding the consumer workspace. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.8.0" />
  </ItemGroup>

  <!-- The CLI's internal scaffolding helpers (e.g. ErrorCodeScaffold) are unit-tested. -->
  <ItemGroup>
    <InternalsVisibleTo Include="Skies.Framework.Cli.Tests" />
  </ItemGroup>

</Project>
