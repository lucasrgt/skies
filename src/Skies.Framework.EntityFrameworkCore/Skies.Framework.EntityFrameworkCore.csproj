<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="..\..\build\Skies.Framework.Library.props" />

  <!--
    The EF Core satellite — deliberately NOT part of the Skies meta-package and the only runtime
    package that references EF Core. The framework's runtime stays persistence-agnostic; an app that
    queries through EF opts into this satellite à la carte, the way it opts into a Testing.* package.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Description>Part of Skies — the EF Core satellite: ToPageAsync, the one-liner that turns an ordered query into the framework's canonical Page&lt;T&gt; (clamped, counted and paged over the same queryable), and the tenancy mechanics: ITenantScoped rows filtered to the current org on read and stamped with it on every save.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.8" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Skies.Framework.Abstractions\Skies.Framework.Abstractions.csproj" />
    <ProjectReference Include="..\..\analyzers\Skies.Framework.SelfHarness\Skies.Framework.SelfHarness.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all" />
  </ItemGroup>

</Project>
