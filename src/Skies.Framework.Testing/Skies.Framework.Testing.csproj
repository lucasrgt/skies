<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="..\..\build\Skies.Framework.Library.props" />

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- This is a shipped framework package, not a test project — the Mvc.Testing reference makes the SDK
         assume otherwise. IsPackable re-enables the package; IsTestProject=false tells the test runner to skip it. -->
    <IsPackable>true</IsPackable>
    <IsTestProject>false</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- No database/provider dependency here: the base is opinion-free. The in-memory fast path
         lives in the separate Skies.Framework.Testing.InMemory package; any other provider is the app's own. -->
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.8" />
  </ItemGroup>

</Project>
