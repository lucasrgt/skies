{
  "name": "@skiesjs/react",
  "version": "5.0.0",
  "description": "Skies Framework frontend spine — router/design-system-agnostic React primitives (AsyncState, Resource, session, paging, …) the app composes.",
  "license": "MIT",
  "author": "Lucas Tinoco",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lucasrgt/skies.git",
    "directory": "frontend-sdk/packages/skies-react"
  },
  "homepage": "https://skies.build",
  "bugs": "https://github.com/lucasrgt/skies/issues",
  "keywords": [
    "react",
    "skies",
    "mvvm",
    "async-state",
    "hooks"
  ],
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json && esbuild src/index.ts --bundle --format=esm --outfile=dist/index.js --sourcemap --external:react --external:react-dom",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {}
}
