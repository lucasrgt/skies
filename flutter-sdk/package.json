{
  "name": "skies-flutter",
  "version": "4.1.24",
  "type": "module",
  "description": "Skies Flutter client generation, MVVM scaffolding, and removable doctor.",
  "sideEffects": false,
  "license": "MIT",
  "author": "Lucas Tinoco",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lucasrgt/skies.git",
    "directory": "flutter-sdk"
  },
  "files": [
    "tools/*.mjs",
    "tools/fixtures/*.json",
    "parity/*.json",
    "openapitools.json",
    "README.md"
  ],
  "exports": {
    "./app-scaffold": "./tools/app-scaffold.mjs",
    "./contract-freshness": "./tools/contract-freshness.mjs",
    "./doctor": "./tools/doctor.mjs",
    "./e2e-doctor": "./tools/e2e-doctor.mjs",
    "./endpoint-coverage": "./tools/endpoint-coverage.mjs",
    "./feature-e2e-coverage": "./tools/feature-e2e-coverage.mjs",
    "./framework-sync": "./tools/framework-sync.mjs",
    "./i18n": "./tools/i18n.mjs",
    "./journey-parity": "./tools/journey-parity.mjs",
    "./package-versions": "./tools/package-versions.mjs",
    "./parity": "./tools/parity.mjs"
  },
  "bin": {
    "skies-flutter-app": "tools/app-scaffold.mjs",
    "skies-flutter-client": "tools/generate-client.mjs",
    "skies-flutter-client-scaffold": "tools/client-scaffold.mjs",
    "skies-flutter-design": "tools/design-scaffold.mjs",
    "skies-flutter-contract-freshness": "tools/contract-freshness.mjs",
    "skies-flutter-i18n": "tools/i18n.mjs",
    "skies-flutter-endpoint-coverage": "tools/endpoint-coverage.mjs",
    "skies-flutter-e2e-doctor": "tools/e2e-doctor.mjs",
    "skies-flutter-feature-e2e": "tools/feature-e2e-coverage.mjs",
    "skies-flutter-journey-parity": "tools/journey-parity.mjs",
    "skies-flutter-framework-sync": "tools/framework-sync.mjs",
    "skies-flutter-parity": "tools/parity.mjs",
    "skies-flutter-feature": "tools/scaffold-feature.mjs",
    "skies-flutter-doctor": "tools/doctor.mjs"
  },
  "scripts": {
    "test": "node --test tools/*.test.mjs",
    "test:contract": "node tools/contract-smoke.mjs",
    "test:parity": "node tools/parity.mjs",
    "restore:dart": "cd packages/skies_flutter && flutter pub get",
    "test:dart": "cd packages/skies_flutter && flutter test",
    "analyze:dart": "flutter analyze packages/skies_flutter",
    "check": "npm test && npm run test:parity && npm run test:contract && npm run restore:dart && npm run analyze:dart && npm run test:dart"
  },
  "dependencies": {
    "@openapitools/openapi-generator-cli": "2.41.0"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  }
}
