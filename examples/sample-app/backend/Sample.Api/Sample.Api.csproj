<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\..\..\..\src\Skies.Framework.Abstractions\Skies.Framework.Abstractions.csproj" />
    <!-- The doctor rides along as a build/IDE analyzer. Remove this line and the app still
         compiles and runs (Law 2) — you only lose the enforcement. -->
    <ProjectReference Include="..\..\..\..\analyzers\Skies.Framework.Doctor\Skies.Framework.Doctor.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\..\..\src\Skies.Framework.AspNetCore\Skies.Framework.AspNetCore.csproj" />
    <ProjectReference Include="..\..\..\..\src\Skies.Framework.EntityFrameworkCore\Skies.Framework.EntityFrameworkCore.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.8" />
    <!-- Build-time OpenAPI: emits the contract at `dotnet build` via the GetDocument tool (no running server). It
         lives in the app, not the framework — the tool needs this project's entry assembly. The framework supplies
         the doc-gen awareness (Skies's OnStartup / IsGeneratingOpenApiDocument), so the build needs no database. -->
    <PackageReference Include="Microsoft.Extensions.ApiDescription.Server" Version="10.0.0" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- Co-located tests live beside the code they exercise. The production assembly never compiles
         them (no test deps ship); the test project pulls them via glob. -->
    <Compile Remove="**\*.Tests.cs" />
    <!-- The doctor reads the module context docs (SKY0004/SKY0005) as AdditionalFiles. -->
    <AdditionalFiles Include="**\*.ctx.md" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- The sample app is not shipped. -->
    <IsPackable>false</IsPackable>
    <!-- Build-time OpenAPI: `dotnet build` emits the contract here via the GetDocument tool (brought transitively by
         Skies.Framework.AspNetCore). DB-free — Program.cs guards seeding with OnStartup, so the build needs no database. This
         is what the typed client generates from, and what CI diffs to catch a stale contract. -->
    <OpenApiDocumentsDirectory>$(MSBuildProjectDirectory)/contract</OpenApiDocumentsDirectory>
  </PropertyGroup>

</Project>
